# -----------------------------------------------------------------------------
# Grocery Hub - Raspberry Pi scanner
# -----------------------------------------------------------------------------

GHCR_OWNER=your-github-user-or-org
GROCERY_VERSION=latest

# URL reachable from the Raspberry Pi.
# Prefer HTTPS through your reverse proxy when crossing untrusted networks.
SCANNER_API_URL=https://grocery.example.com

# Must match one entry from SCANNER_DEVICE_TOKENS on the server.
SCANNER_DEVICE_ID=kitchen
SCANNER_DEVICE_TOKEN=CHANGE_ME_RANDOM_DEVICE_TOKEN

# Find the real path with: ls -l /dev/input/by-id/
SCANNER_DEVICE_GLOB=/dev/input/by-id/*SCAN_KEYBOARD*event-kbd

# Local durable queue inside the scanner volume.
SCANNER_SPOOL_PATH=/data/scanner-spool.db

# Retry interval when the central API is unavailable.
SCANNER_RETRY_SECONDS=10
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Grocery Hub - Docker server
# -----------------------------------------------------------------------------

# GitHub Container Registry
GHCR_OWNER=your-github-user-or-org
GROCERY_VERSION=latest

# PostgreSQL
POSTGRES_DB=grocery
POSTGRES_USER=grocery
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://grocery:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/grocery

# Redis
REDIS_URL=redis://redis:6379/0

# The web container reaches the API at http://api:8000 over the Docker network.
# No public API URL or browser build-time environment variable is needed.

# Scanner authentication.
# Format: device_id:token. Multiple devices are separated with commas.
# Example: kitchen:secret1,garage:secret2
SCANNER_DEVICE_TOKENS=kitchen:CHANGE_ME_RANDOM_DEVICE_TOKEN

# Store connectors - leave blank until each connector is implemented/configured.
BRING_EMAIL=
BRING_PASSWORD=
BRING_LIST_NAME=Maison

PICNIC_USERNAME=
PICNIC_PASSWORD=

CHRONODRIVE_USERNAME=
CHRONODRIVE_PASSWORD=
